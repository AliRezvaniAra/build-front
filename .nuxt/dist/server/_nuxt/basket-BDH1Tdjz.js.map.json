A;AAAA,wCACnDF,YAAkG,OAAA,EAA7F,OAAM,8DAAA,GAA8D,UAAKE,gBAAG,KAAK,GAAG,GAAA,CAAA;AAAA,sCAAA;sCAE3FF,YAEM,OAAA,EAFD,OAAM,4DACN,KAAK,QAAQ,IAAG,uBAAK,WAAW,KAAK,KAAK,IAAI,KAAK,UAAU,eAAA,CAAc,GAAA,CAAA;AAAA,oCAAA;oCAIlFA,YAAwBD,SAAA,EAAd,OAAM,QAAM;AAAA,oCAEtBC,YAiCM,OAAA,EAjCD,OAAM,uDAAmD;AAAA,sCAC5DA,YAgBM,OAAA,EAhBD,OAAM,6DAAyD;AAAA,wCAClEA,YAMEG,MAAA;AAAA,0CALA,MAAK;AAAA,0CACL,SAAQ;AAAA,0CACR,SAAQ;AAAA,0CACR,MAAK;AAAA,0CACJ,SAAK,CAAA,WAAEb,MAAA,eAAA,EAAgB,KAAK,IAAI,KAAK,KAAK,KAAK,WAAQ,CAAA;AAAA,wCAAA;wCAE1DU,YAA8D,UAAxD,OAAM,wBAAA,GAAuBE,gBAAI,KAAK,QAAQ,GAAA,CAAA;AAAA,wCACpDF,YAMEG,MAAA;AAAA,0CALA,MAAK;AAAA,0CACL,SAAQ;AAAA,0CACR,SAAQ;AAAA,0CACR,MAAK;AAAA,0CACJ,SAAK,CAAA,WAAEb,MAAA,eAAA,EAAgB,KAAK,IAAI,KAAK,KAAK,KAAK,WAAQ,CAAA;AAAA,wCAAA;;sCAI5DU,YAaM,OAAA,EAbD,OAAM,kBAAc;AAAA,wCACvBA,YAKEG,MAAA;AAAA,0CAJE,OAAM;AAAA,0CACN,SAAQ;AAAA,0CACR,MAAK;AAAA,0CACJ,SAAK,CAAA,WAAEb,sBAAe,KAAK,IAAI,KAAK,GAAG;AAAA,wCAAA;wCAE5CU,YAKEG,MAAA;AAAA,0CAJG,IAAE,IAAM,OAAA,KAAM,aAAa,KAAK,IAAI;AAAA,0CACrC,SAAQ;AAAA,0CACR,MAAK;AAAA,0CACL,OAAM;AAAA,wCAAA;;;;;;;;;;;;sBAStBH,YAgCQW,MAAA;AAAA,wBAhCD,MAAK;AAAA,wBAAK,IAAG;AAAA,sBAAA;yCAClB,MA8BS;AAAA,0BA9BTX,YA8BSO,OAAA;AAAA,4BA9BD,OAAM;AAAA,4BAA+B,SAAQ;AAAA,4BAAK,WAAU;AAAA,4BAAI,QAAA;AAAA,0BAAA;6CACtE,MAAsE;AAAA,8BAAtEP,YAAsE,MAAA,EAAlE,OAAM,gCAAA,mBAAmCV,MAAA,CAAA,EAAE,QAAQ,OAAO,GAAA,CAAA;AAAA,8BAE9DU,YAGM,OAAA,EAHD,OAAM,mDAA+C;AAAA,gCACxDA,YAAqF,QAAA,EAA/E,OAAM,0CAA0BV,MAAA,CAAA,EAAE,QAAQ,KAAK,IAAG,OAAEY,gBAAGZ,MAAA,aAAA,CAAa,IAAG,KAAC,CAAA;AAAA,gCAC9EU,YAA4C,QAAA,MAAAE,gBAAnC,YAAYZ,MAAA,YAAA,CAAY,CAAA,GAAA,CAAA;AAAA,8BAAA;8BAGnCU,YAGM,OAAA,EAHD,OAAM,mDAA+C;AAAA,gCACxDA,YAAkE,QAAA,EAA5D,OAAM,uBAAA,mBAA0BV,MAAA,CAAA,EAAE,QAAQ,QAAQ,GAAA,CAAA;AAAA,gCACxDU,YAAyE,QAAA,EAAnE,OAAM,kCAAA,mBAAqCV,MAAA,CAAA,EAAE,QAAQ,IAAI,GAAA,CAAA;AAAA,8BAAA;8BAGjEU,YAAyBQ,UAAA,EAAd,OAAM,QAAM;AAAA,8BAEvBR,YAMM,OAAA,EAND,OAAM,iDAA6C;AAAA,gCACtDA,YAAkD,QAAA,EAA5C,OAAM,UAAA,mBAAaV,MAAA,CAAA,EAAE,QAAQ,KAAK,GAAA,CAAA;AAAA,gCACxCU,YAGM,OAAA,EAHD,OAAM,gBAAY;AAAA,kCACrBA,YAAyF,SAApF,OAAM,yCAAA,GAAwCE,gBAAI,YAAYZ,MAAA,YAAA,CAAY,CAAA,GAAA,CAAA;AAAA,kCAC/EU,YAAyF,OAAA,EAApF,OAAM,2CAAA,GAA2C,+BAA6B;AAAA,gCAAA;;8BAIvFA,YAEQG,MAAA;AAAA,gCAFD,OAAA;AAAA,gCAAM,OAAM;AAAA,gCAAU,MAAK;AAAA,gCAAU,SAAQ;AAAA,gCAAO,OAAM;AAAA,gCAAmB,WAAU;AAAA,8BAAA;iDAC5F,MAAwB;AAAA,kEAArBb,MAAA,CAAA,EAAE,QAAQ,QAAQ,GAAA,CAAA;AAAA,gCAAA;;;8BAGvBU,YAEQG,MAAA;AAAA,gCAFD,SAAQ;AAAA,gCAAO,OAAA;AAAA,gCAAM,OAAM;AAAA,gCAAuC,QAAQ,OAAA,KAAM;AAAA,8BAAA;iDACrF,MAAqC;AAAA,kCAArCH,YAAqCS,OAAA,EAA7B,OAAA,MAAK;AAAA,qDAAC,MAAc;AAAA,sDAAd,gBAAc;AAAA,oCAAA;;;kCAASC,gBAAA,MAACR,gBAAGZ,MAAA,CAAA,EAAE,QAAQ,QAAQ,GAAA,CAAA;AAAA,gCAAA;;;;;;;;;;;;;;;;;;;;;QAQ9D,MAAM,OAAA;AAAA,QAAQ,cAAW;AAAA,QAAM,WAAU;AAAA,QAAa,QAAQ,OAAA;AAAA,MAAA;;;;;;;;;;;;","names":["_unref","_push","_parent","_","_scopeId","_ssrRenderComponent","_component_v_fade_transition","_ssrRenderList","_ssrInterpolate","_component_v_spacer","_createVNode","_component_v_img","_toDisplayString","_component_v_btn","_createBlock","_Fragment","_renderList","_component_v_card","_component_v_divider","_component_v_icon","_createTextVNode","_component_v_col","_component_v_row"],"sources":["../../../../app/pages/[lang]/basket.vue"],"sourcesContent":["<script setup lang=\"ts\">\r\n\r\nimport Header1Mobile from \"../../components/editorElements/elements/headers/header1Mobile.vue\";\r\nimport Header1 from \"../../components/editorElements/elements/headers/header1.vue\";\r\nimport Render from \"../../components/editorElements/Render.vue\";\r\nimport type {Row} from \"../../types/EditorTypes\";\r\nimport {ref} from \"vue\";\r\nimport {useRoute} from \"vue-router\";\r\nimport {useDisplay} from 'vuetify'\r\nimport { routeParamString } from \"../../utils/routeParams\";\r\nimport {useTrans} from \"../../../composables/useTrans\";\r\nconst { t } = useTrans()\r\ntype RowsApi = { data: Row[] }\r\n\r\nconst route = useRoute()\r\nconst footer = ref<Row[]>([])\r\nconst related_pages = ref<{ lang: string; title: string }[]>([])\r\nconst {mdAndUp} = useDisplay()\r\nconst config = useRuntimeConfig()\r\nconst locale = ref<string>(routeParamString(route.params.lang))\r\n\r\nconst {\r\n  cart,\r\n  setLineQuantity,\r\n  removeFromCart,\r\n  clearCart,\r\n  cartItemCount,\r\n  cartSubtotal,\r\n} = useShopLocal()\r\n\r\nconst {data: languages} = useAsyncData(\r\n    `languages`,\r\n    async () => {\r\n      const res= await $fetch(`/api/languages`, {\r\n        baseURL: config.public.baseUrl,\r\n      });\r\n      related_pages.value=res.map(l=> {\r\n        return {lang:l.code, title:'basket'}})\r\n      return res;\r\n    }\r\n)\r\nwatch(languages.value,()=>{\r\n  if(!!languages.value)\r\n    related_pages.value=languages.value.map(l=> {\r\n      return {lang:l.code, title:'basket'}\r\n    })\r\n},{immediate:true,deep:true})\r\nconst {data: header} = useAsyncData<Row[]>(\r\n    'header-data',\r\n    async () => {\r\n      const res: any = await $fetch(`/api/pages/rows/0-header`, {\r\n        baseURL: config.public.baseUrl\r\n      })\r\n      return res.data || []\r\n    }\r\n)\r\nconst {data: menu} = useAsyncData<Row[]>(\r\n    'menu-data',\r\n    async () => {\r\n      const res: any = await $fetch(`/api/menus/get`, {\r\n        baseURL: config.public.baseUrl\r\n      })\r\n      return res.data || []\r\n    }\r\n)\r\nconst {data: footerData} = useAsyncData<RowsApi>(\r\n    () => `page-footer-${locale.value}-${routeParamString(route.params.lang)}`,\r\n    async () => {\r\n      const result = await $fetch<RowsApi>(`/api/pages/rows/0-footer-${routeParamString(route.params.lang)}`, {\r\n        baseURL: config.public.baseUrl,\r\n      })\r\n      footer.value = result?.data ?? []\r\n      return result;\r\n    }\r\n)\r\n\r\nif (footerData.value?.data) {\r\n  footer.value = footerData.value.data\r\n}\r\n\r\nfunction formatMoney(n: number) {\r\n  return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })\r\n}\r\n</script>\r\n\r\n<template>\r\n  <Header1 v-if=\"mdAndUp\" :theme=\"'light'\" :header=\"header??[]\" :menu=\"menu??[]\" :languages=\"languages as any\"\r\n           :related_pages=\"related_pages\" :locale=\"locale as string\"/>\r\n  <Header1Mobile v-else :theme=\"'light'\" :rows=\"header??[]\" :menu=\"menu??[]\" :languages=\"languages as any\"\r\n                 :related_pages=\"related_pages\" :locale=\"locale as string\"/>\r\n\r\n  <v-container class=\"shop-page py-10\" :style=\"{direction: (locale==='fa' || locale==='ar')?'rtl':'ltr'}\">\r\n    <div class=\"d-flex align-end justify-space-between mb-8\">\r\n      <div>\r\n        <h1 class=\"text-h3 font-weight-bold mb-1\">{{ t.basket?.title }}</h1>\r\n        <p class=\"text-body-1 text-medium-emphasis\">{{ t.basket?.subtitle }}</p>\r\n      </div>\r\n      <v-btn\r\n          v-if=\"cart.length\"\r\n          color=\"error\"\r\n          variant=\"tonal\"\r\n          prepend-icon=\"mdi-delete-sweep-outline\"\r\n          @click=\"clearCart\"\r\n      >\r\n        {{ t.basket?.clear_all }}\r\n      </v-btn>\r\n    </div>\r\n\r\n    <v-fade-transition hide-on-leave>\r\n      <div v-if=\"!cart.length\" class=\"text-center py-16 border rounded-xl bg-grey-lighten-5\">\r\n        <v-icon size=\"80\" color=\"grey-lighten-1\" class=\"mb-4\">mdi-cart-outline</v-icon>\r\n        <h2 class=\"text-h5 font-weight-medium mb-2\">{{ t.basket?.empty_title }}</h2>\r\n        <p class=\"text-body-1 text-medium-emphasis mb-6\">{{ t.basket?.empty_subtitle }}</p>\r\n        <v-btn :to=\"`/${locale}`\" color=\"primary\" size=\"large\" rounded=\"pill\" elevation=\"2\">\r\n          {{ t.basket?.start_shopping }}\r\n        </v-btn>\r\n      </div>\r\n\r\n      <v-row v-else>\r\n        <v-col cols=\"12\" lg=\"8\">\r\n          <v-card \r\n            v-for=\"line in cart\" \r\n            :key=\"`${line.id}-${line.sku}`\" \r\n            class=\"mb-4 product-card\" \r\n            elevation=\"1\" \r\n            rounded=\"xl\"\r\n          >\r\n            <div class=\"d-flex flex-column flex-sm-row pa-5 gap-6\">\r\n              <v-img\r\n                :src=\"line.image\" \r\n                width=\"140\" \r\n                height=\"140\" \r\n                cover \r\n                rounded=\"lg\" \r\n                class=\"bg-grey-lighten-4 flex-grow-0\"\r\n              />\r\n              \r\n              <div class=\"flex-grow-1 d-flex flex-column px-3\">\r\n                <div class=\"d-flex justify-space-between align-start\">\r\n                  <div>\r\n                    <div class=\"text-h6 font-weight-bold\">{{ line.title }}</div>\r\n                    <div class=\"text-caption text-medium-emphasis uppercase tracking-widest\">SKU: {{ line.sku }}</div>\r\n                  </div>\r\n                  <div class=\"text-h6 font-weight-black text-primary\">\r\n                    {{ line.currency }} {{ (parseFloat(line.price) * line.quantity).toLocaleString() }}\r\n                  </div>\r\n                </div>\r\n\r\n                <v-spacer class=\"my-4\"/>\r\n\r\n                <div class=\"d-flex align-center justify-space-between mt-auto\">\r\n                  <div class=\"quantity-picker d-flex align-center border rounded-pill\">\r\n                    <v-btn \r\n                      icon=\"mdi-minus\" \r\n                      variant=\"text\" \r\n                      density=\"comfortable\" \r\n                      size=\"small\" \r\n                      @click=\"setLineQuantity(line.id, line.sku, line.quantity - 1)\"\r\n                    />\r\n                    <span class=\"px-4 font-weight-bold\">{{ line.quantity }}</span>\r\n                    <v-btn \r\n                      icon=\"mdi-plus\" \r\n                      variant=\"text\" \r\n                      density=\"comfortable\" \r\n                      size=\"small\" \r\n                      @click=\"setLineQuantity(line.id, line.sku, line.quantity + 1)\"\r\n                    />\r\n                  </div>\r\n\r\n                  <div class=\"d-flex gap-2\">\r\n                    <v-btn\r\n                        color=\"error\"\r\n                        variant=\"text\"\r\n                        icon=\"mdi-trash-can-outline\"\r\n                        @click=\"removeFromCart(line.id, line.sku)\"\r\n                    />\r\n                    <v-btn\r\n                        :to=\"`/${locale}/products/${line.slug}`\"\r\n                        variant=\"text\"\r\n                        icon=\"mdi-eye-outline\"\r\n                        color=\"medium-emphasis\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </v-card>\r\n        </v-col>\r\n\r\n        <v-col cols=\"12\" lg=\"4\">\r\n          <v-card class=\"summary-card pa-6 sticky-top\" rounded=\"xl\" elevation=\"4\" border>\r\n            <h2 class=\"text-h5 font-weight-bold mb-6\">{{ t.basket?.summary }}</h2>\r\n            \r\n            <div class=\"d-flex justify-space-between mb-3 text-body-1\">\r\n              <span class=\"text-medium-emphasis\">{{ t.basket?.items }} ({{ cartItemCount }})</span>\r\n              <span>{{ formatMoney(cartSubtotal) }}</span>\r\n            </div>\r\n            \r\n            <div class=\"d-flex justify-space-between mb-6 text-body-1\">\r\n              <span class=\"text-medium-emphasis\">{{ t.basket?.shipping }}</span>\r\n              <span class=\"text-success font-weight-medium\">{{ t.basket?.free }}</span>\r\n            </div>\r\n\r\n            <v-divider class=\"mb-6\"/>\r\n\r\n            <div class=\"d-flex justify-space-between align-end mb-8\">\r\n              <span class=\"text-h6\">{{ t.basket?.total }}</span>\r\n              <div class=\"text-right\">\r\n                <div class=\"text-h4 font-weight-black text-primary\">{{ formatMoney(cartSubtotal) }}</div>\r\n                <div class=\"text-caption text-medium-emphasis italic\">VAT included where applicable</div>\r\n              </div>\r\n            </div>\r\n\r\n            <v-btn block color=\"primary\" size=\"x-large\" rounded=\"pill\" class=\"font-weight-bold\" elevation=\"3\">\r\n              {{ t.basket?.checkout }}\r\n            </v-btn>\r\n            \r\n            <v-btn variant=\"text\" block class=\"mt-4 text-none text-medium-emphasis\" :to=\"`/${locale}`\">\r\n              <v-icon start>mdi-arrow-left</v-icon> {{ t.basket?.continue }}\r\n            </v-btn>\r\n          </v-card>\r\n        </v-col>\r\n      </v-row>\r\n    </v-fade-transition>\r\n  </v-container>\r\n\r\n  <Render :rows=\"footer\" margin-top=\"0px\" is_footer=\"is_footer\" :locale=\"locale\"/>\r\n</template>\r\n\r\n<style scoped>\r\n.shop-page {\r\n  min-height: 80vh;\r\n  background-color: #fcfcfc;\r\n}\r\n\r\n.product-card {\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 20px rgba(0,0,0,0.08) !important;\r\n}\r\n\r\n.quantity-picker {\r\n  background: #f8f9fa;\r\n}\r\n\r\n.sticky-top {\r\n  position: sticky;\r\n  top: 100px;\r\n}\r\n\r\n.uppercase {\r\n  text-transform: uppercase;\r\n}\r\n\r\n.tracking-widest {\r\n  letter-spacing: 0.1em;\r\n}\r\n</style>"],"version":3}