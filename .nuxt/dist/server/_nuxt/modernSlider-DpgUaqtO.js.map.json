wBAEvDC,YAGM,OAAA,EAHD,OAAM,kBAAc;AAAA,0BACvBA,YAAsNC,MAAA;AAAA,4BAA/M,MAAK;AAAA,4BAAmB,SAAQ;AAAA,4BAAW,MAAK;AAAA,4BAAS,OAAK,EAAA,OAAW,MAAM,OAAO,YAAA,KAAW,EAAE,cAAU,SAAA,aAA0B,MAAM,OAAO,YAAA,KAAW,EAAE,cAAU,QAAA;AAAA,4BAAgB,SAAO;AAAA,0BAAA;0BACzMD,YAAuNC,MAAA;AAAA,4BAAhN,MAAK;AAAA,4BAAoB,SAAQ;AAAA,4BAAW,MAAK;AAAA,4BAAS,OAAK,EAAA,OAAW,MAAM,OAAO,YAAA,KAAW,EAAE,cAAU,SAAA,aAA0B,MAAM,OAAO,YAAA,KAAW,EAAE,cAAU,QAAA;AAAA,4BAAgB,SAAO;AAAA,0BAAA;;wBAG5MD,YAYM,OAAA,EAZD,OAAM,yDAAqD;AAAA,0BAC9DA,YAAoF,UAA9E,OAAM,2CAAA,GAA2C,sBAAI,YAAA,QAAW,CAAA,GAAA,CAAA;AAAA,0BACtEA,YAQM,OAAA;AAAA,4BARD,OAAM;AAAA,4BAA8D,OAAA,EAAA,UAAA,MAAA;AAAA,0BAAA;4BACvEA,YAMO,OAAA;AAAA,8BALH,OAAM;AAAA,8BACL,OAAK;AAAA,gCAAqC,OAAA,IAAA,YAAA,QAAW,KAAQ,MAAM,OAAO,SAAM,GAAA;AAAA,gCAAkD,iBAAA,MAAM,OAAO,YAAA,KAAW,EAAE,eAAU,UAAA,UAAA;AAAA,8BAAA;AAAA;;0BAM7KA,YAAwF,QAAA,EAAlF,OAAM,2CAAA,GAA2C,MAACF,gBAAG,MAAM,OAAO,MAAM,GAAA,CAAA;AAAA,wBAAA;;;;;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttr","_unref","_push","_parent","_ssrRenderComponent","_component_v_row","_","_scopeId","_ssrRenderStyle","_ssrInterpolate","_createTextVNode","_toDisplayString","_createBlock","_createVNode","_component_v_btn","_ssrRenderList","_ssrRenderClass","_openBlock","_Fragment","_component_v_col"],"sources":["../../../../app/components/editorElements/elements/modernSlider.vue"],"sourcesContent":["<template>\r\n  <div\r\n      ref=\"rootRef\"\r\n      :style=\"{ minHeight: sliderHeight ,borderRadius: borderRadius }\"\r\n      class=\"ma-0 pa-0 bg-black text-white overflow-hidden position-relative\"\r\n  >\r\n\r\n    <div class=\"position-absolute inset-0 w-100 h-100 main-bg-wrapper z-index-1\">\r\n      <img\r\n          v-if=\"props.slides && props.slides.length > 0\"\r\n          ref=\"bgImageRef\"\r\n          :src=\"config.public.baseUrl+'/'+props.slides[activeIndex].image\"\r\n          class=\"w-100 h-100 object-cover brightness-50 position-absolute inset-0\"\r\n       :alt=\"props.slides[activeIndex].largeTitle\"/>\r\n      <img\r\n          v-if=\"props.slides && props.slides.length > 0\"\r\n          ref=\"bgRevealRef\"\r\n          :src=\"config.public.baseUrl+'/'+revealImageSrc\"\r\n          class=\"w-100 h-100 object-cover brightness-50 position-absolute inset-0 bg-reveal-layer\"\r\n      />\r\n    </div>\r\n\r\n    <v-container fluid class=\"fill-height px-6 px-md-12 position-relative z-index-2\" >\r\n      <v-row class=\"align-center fill-height\" >\r\n\r\n        <v-col\r\n            cols=\"12\"\r\n            md=\"6\"\r\n            class=\"d-flex flex-column justify-center pt-mobile pt-md-16\"\r\n        >\r\n          <div v-if=\"props.slides && props.slides.length > 0\" class=\"text-animation-container\">\r\n            <span\r\n                ref=\"subTitleRef\"\r\n                class=\"text-uppercase text-subtitle-2 font-weight-bold tracking-widest mb-2 d-block transition-colors\"\r\n                :style=\"{ color: props.slides[activeIndex].subTitleColor || 'white' }\"\r\n            >\r\n              {{ props.slides[activeIndex].subTitle }}\r\n            </span>\r\n\r\n            <h2\r\n                ref=\"titleRef\"\r\n                class=\"text-h3 text-md-h2 font-weight-black text-uppercase mb-4 tracking-tight leading-tight transition-colors\"\r\n                :style=\"{ color: props.slides[activeIndex].titleColor || 'white' }\"\r\n            >\r\n              {{ props.slides[activeIndex].largeTitle }}\r\n            </h2>\r\n\r\n            <p\r\n                ref=\"descRef\"\r\n                class=\"text-body-2 text-md-body-1 mb-6 max-w-sm  transition-colors\"\r\n                :style=\"{ color: props.slides[activeIndex].descColor || 'white' }\"\r\n            >\r\n              {{ props.slides[activeIndex].description }}\r\n            </p>\r\n\r\n            <div ref=\"btnRef\">\r\n              <v-btn\r\n                  :href=\"props.slides[activeIndex].btnLink\"\r\n                  variant=\"outlined\"\r\n                  rounded=\"xl\"\r\n                  class=\"px-6 text-none font-weight-bold transition-colors\"\r\n                  :style=\"{\r\n                    color: props.slides[activeIndex].btnTextColor || 'white',\r\n                    borderColor: props.slides[activeIndex].btnBorderColor || 'white'\r\n                  }\"\r\n              >\r\n                {{ props.slides[activeIndex].btnTitle }}\r\n              </v-btn>\r\n            </div>\r\n          </div>\r\n        </v-col>\r\n\r\n        <v-col cols=\"12\" md=\"6\" class=\"d-flex flex-column justify-end justify-md-end align-md-end h-md-100 position-relative z-index-3\">\r\n\r\n          <div class=\"d-none d-md-block mb-8 index-track-window\">\r\n            <div ref=\"trackRowRef\" class=\"track-row position-relative w-100 h-100\">\r\n              <div\r\n                  v-for=\"(slide, idx) in props.slides\"\r\n                  :key=\"slide.id\"\r\n                  class=\"thumbnail-card position-absolute rounded-lg overflow-hidden elevation-4\"\r\n                  :class=\"{ 'is-active': idx === activeIndex }\"\r\n                  @click=\"changeSlide(idx, $event)\"\r\n              >\r\n                <img\r\n                    :src=\"config.public.baseUrl+'/'+slide.image\"\r\n                    class=\"w-100 h-100 object-cover brightness-90\"\r\n                />\r\n                <div class=\"position-absolute bottom-0 left-0 right-0 pa-4 bg-gradient-vertical text-white\">\r\n                  <div class=\"text-caption text-grey-lighten-2 text-uppercase font-weight-medium truncate\">{{ slide.subTitle }}</div>\r\n                  <div class=\"text-body-2 font-weight-bold text-uppercase tracking-wide truncate\">{{ slide.largeTitle }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div\r\n              v-if=\"props.slides && props.slides.length > 0\"\r\n              class=\"d-flex align-center justify-space-between pl-md-12 w-100  transition-colors\"\r\n              :style=\"{ color: props.slides[activeIndex].titleColor || 'white' }\"\r\n          >\r\n            <div class=\"d-flex gap-3\">\r\n              <v-btn icon=\"mdi-chevron-left\" variant=\"outlined\" size=\"small\" :style=\"{ color: props.slides[activeIndex].titleColor || 'white', borderColor: props.slides[activeIndex].titleColor || 'white' }\" @click=\"prevSlide\" />\r\n              <v-btn icon=\"mdi-chevron-right\" variant=\"outlined\" size=\"small\" :style=\"{ color: props.slides[activeIndex].titleColor || 'white', borderColor: props.slides[activeIndex].titleColor || 'white' }\" @click=\"nextSlide\" />\r\n            </div>\r\n\r\n            <div class=\"d-flex align-center gap-4 flex-grow-1 ml-6 max-w-xs\">\r\n              <span class=\"text-caption font-weight-bold opacity-75\">0{{ activeIndex + 1 }}</span>\r\n              <div class=\"flex-grow-1 bg-grey-darken-3 rounded-pill position-relative\" style=\"height: 2px;\">\r\n                <div\r\n                    class=\"rounded-pill h-100 position-absolute left-0 top-0 transition-width\"\r\n                    :style=\"{\r\n                    width: `${((activeIndex + 1) / props.slides.length) * 100}%`,\r\n                    backgroundColor: props.slides[activeIndex].titleColor === 'black' ? 'black' : '#FFD700'\r\n                  }\"\r\n                ></div>\r\n              </div>\r\n              <span class=\"text-caption font-weight-bold opacity-50\">0{{ props.slides.length }}</span>\r\n            </div>\r\n          </div>\r\n\r\n        </v-col>\r\n      </v-row>\r\n    </v-container>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted, onBeforeUnmount, watch, nextTick } from 'vue'\r\nimport gsap from 'gsap'\r\n\r\nconst props = defineProps({\r\n  sliderHeight: { type: String, default: '100vh' },\r\n  slides: { type: Array, required: true },\r\n  autoPlay: { type: Boolean, default: true },\r\n  delay: { type: Number, default: 5000 },\r\n  borderRadius: '0px'\r\n})\r\n\r\nconst activeIndex = ref(0)\r\n\r\nconst rootRef = ref(null)\r\nconst bgImageRef = ref(null)\r\nconst bgRevealRef = ref(null)\r\nconst subTitleRef = ref(null)\r\nconst titleRef = ref(null)\r\nconst descRef = ref(null)\r\nconst btnRef = ref(null)\r\nconst mobileNumRef = ref(null)\r\nconst trackRowRef = ref(null)\r\nconst config = useRuntimeConfig()\r\nconst revealImageSrc = ref(props.slides && props.slides.length > 0 ? props.slides[0].image : '')\r\n\r\nlet activeTimeline = null\r\nlet autoPlayTimer = null\r\n\r\nconst customMod = (n, m) => ((n % m) + m) % m\r\n\r\nconst getLoopOffset = (cardIdx, activeIdx, total) => {\r\n  const diff = cardIdx - activeIdx\r\n  return customMod(diff + Math.floor(total / 2), total) - Math.floor(total / 2)\r\n}\r\n\r\nconst updateTrackLayout = () => {\r\n  if (!process.client || !trackRowRef.value || !props.slides?.length) return\r\n\r\n  const cards = trackRowRef.value.children\r\n  const totalSlides = props.slides.length\r\n  const cardWidth = 130\r\n  const gap = 16\r\n  const midPointX = 0\r\n\r\n  Array.from(cards).forEach((card, idx) => {\r\n    const relativeOffset = getLoopOffset(idx, activeIndex.value, totalSlides)\r\n    const targetX = midPointX + (relativeOffset * (cardWidth + gap))\r\n\r\n    let opacityValue = 0.6\r\n    let zIndexValue = 10\r\n    let scaleValue = 0.85\r\n\r\n    if (relativeOffset < 0) {\r\n      zIndexValue = 10 + relativeOffset\r\n      if (relativeOffset < -1) opacityValue = 0\r\n    } else if (relativeOffset > 0) {\r\n      zIndexValue = 20 - relativeOffset\r\n      if (relativeOffset > 2) opacityValue = 0\r\n    } else {\r\n      opacityValue = 1\r\n      zIndexValue = 50\r\n      scaleValue = 1.0\r\n    }\r\n\r\n    gsap.to(card, {\r\n      x: targetX,\r\n      scale: scaleValue,\r\n      opacity: opacityValue,\r\n      zIndex: zIndexValue,\r\n      autoAlpha: opacityValue > 0 ? 1 : 0,\r\n      duration: 0.55,\r\n      ease: 'power2.out'\r\n    })\r\n  })\r\n}\r\n\r\nconst stopAutoPlay = () => {\r\n  if (autoPlayTimer) {\r\n    clearInterval(autoPlayTimer)\r\n    autoPlayTimer = null\r\n  }\r\n}\r\n\r\nconst startAutoPlay = () => {\r\n  stopAutoPlay()\r\n  if (!props.autoPlay || !props.slides?.length || props.slides.length <= 1) return\r\n\r\n  autoPlayTimer = setInterval(() => {\r\n    const nextIdx = (activeIndex.value + 1) % props.slides.length\r\n    runSlideTransition(nextIdx, getDirectionalOrigin(nextIdx))\r\n  }, props.delay)\r\n}\r\n\r\nconst getOriginFromEvent = (event) => {\r\n  if (!event || !rootRef.value) return { x: 50, y: 50 }\r\n  const rect = rootRef.value.getBoundingClientRect()\r\n  const x = ((event.clientX - rect.left) / rect.width) * 100\r\n  const y = ((event.clientY - rect.top) / rect.height) * 100\r\n  return { x: Math.min(100, Math.max(0, x)), y: Math.min(100, Math.max(0, y)) }\r\n}\r\n\r\nconst getDirectionalOrigin = (newIndex) => {\r\n  const total = props.slides.length\r\n  const forwardDistance = customMod(newIndex - activeIndex.value, total)\r\n  const backwardDistance = total - forwardDistance\r\n  const goingForward = forwardDistance <= backwardDistance\r\n  return goingForward ? { x: 96, y: 50 } : { x: 4, y: 50 }\r\n}\r\n\r\n// --- helper: only animate refs that actually exist ---\r\nconst safeSet = (el, vars) => { if (el) gsap.set(el, vars) }\r\nconst safeTo = (timeline, el, vars, position) => { if (el) timeline.to(el, vars, position) }\r\n\r\nconst playIntroAnimation = () => {\r\n  if (!process.client) return\r\n\r\n  const nodes = [\r\n    { el: titleRef.value, vars: { opacity: 0, y: 35 } },\r\n    { el: descRef.value, vars: { opacity: 0, y: 25 } },\r\n    { el: btnRef.value, vars: { opacity: 0, y: 20 } },\r\n    { el: subTitleRef.value, vars: { opacity: 0, y: -25 } },\r\n    { el: mobileNumRef.value, vars: { opacity: 0, y: 20 } }\r\n  ]\r\n\r\n  // nothing rendered at all yet (e.g. slides still empty) — skip, the watcher will retry\r\n  if (nodes.every(n => !n.el)) return\r\n\r\n  nodes.forEach(n => safeSet(n.el, n.vars))\r\n\r\n  const tl = gsap.timeline({ delay: 0.1 })\r\n  safeTo(tl, subTitleRef.value, { opacity: 1, y: 0, duration: 0.45, ease: 'back.out(1.4)' }, 0)\r\n  safeTo(tl, mobileNumRef.value, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.05)\r\n  safeTo(tl, titleRef.value, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 0.15)\r\n  safeTo(tl, descRef.value, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 0.4)\r\n  safeTo(tl, btnRef.value, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.6)\r\n}\r\n\r\nconst runSlideTransition = (targetIndex, origin = { x: 50, y: 50 }) => {\r\n  if (!process.client) return\r\n  const targetSlide = props.slides?.[targetIndex]\r\n  if (!targetSlide || !bgRevealRef.value) return // nothing to animate against yet\r\n\r\n  if (activeTimeline) activeTimeline.kill()\r\n  activeTimeline = gsap.timeline()\r\n\r\n  const textNodes = [subTitleRef.value, titleRef.value, descRef.value, btnRef.value, mobileNumRef.value].filter(Boolean)\r\n\r\n  revealImageSrc.value = targetSlide.image\r\n  gsap.set(bgRevealRef.value, {\r\n    opacity: 1,\r\n    clipPath: `inset(${origin.y}% ${100 - origin.x}% ${100 - origin.y}% ${origin.x}%)`\r\n  })\r\n\r\n  if (textNodes.length) {\r\n    activeTimeline.to(textNodes, { opacity: 0, y: -15, duration: 0.2, ease: 'power2.in' }, 0)\r\n  }\r\n\r\n  activeTimeline.to(bgRevealRef.value, {\r\n    clipPath: `inset(0% 0% 0% 0% round 16px)`,\r\n    duration: 0.8,\r\n    ease: 'power2.inOut'\r\n  }, 0.05)\r\n\r\n  activeTimeline.call(() => {\r\n    activeIndex.value = targetIndex\r\n    gsap.set(bgRevealRef.value, { opacity: 0 })\r\n    updateTrackLayout()\r\n\r\n    safeSet(titleRef.value, { opacity: 0, y: 35 })\r\n    safeSet(descRef.value, { opacity: 0, y: 25 })\r\n    safeSet(btnRef.value, { opacity: 0, y: 20 })\r\n    safeSet(subTitleRef.value, { opacity: 0, y: -25 })\r\n    safeSet(mobileNumRef.value, { opacity: 0, y: 20 })\r\n  }, null, 0.7)\r\n\r\n  safeTo(activeTimeline, subTitleRef.value, { opacity: 1, y: 0, duration: 0.4, ease: 'back.out(1.4)' }, 0.8)\r\n  safeTo(activeTimeline, mobileNumRef.value, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.85)\r\n  safeTo(activeTimeline, titleRef.value, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 0.9)\r\n  safeTo(activeTimeline, descRef.value, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 1.05)\r\n  safeTo(activeTimeline, btnRef.value, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 1.2)\r\n}\r\n\r\nconst changeSlide = (newIndex, event = null) => {\r\n  if (newIndex === activeIndex.value) return\r\n  stopAutoPlay()\r\n  const origin = event ? getOriginFromEvent(event) : getDirectionalOrigin(newIndex)\r\n  runSlideTransition(newIndex, origin)\r\n  startAutoPlay()\r\n}\r\n\r\nconst nextSlide = () => {\r\n  if (!props.slides?.length) return\r\n  changeSlide((activeIndex.value + 1) % props.slides.length)\r\n}\r\n\r\nconst prevSlide = () => {\r\n  if (!props.slides?.length) return\r\n  changeSlide((activeIndex.value - 1 + props.slides.length) % props.slides.length)\r\n}\r\n\r\nwatch(() => props.autoPlay, (newVal) => {\r\n  if (newVal) startAutoPlay()\r\n  else stopAutoPlay()\r\n})\r\n\r\nwatch(() => props.delay, () => {\r\n  if (props.autoPlay) startAutoPlay()\r\n})\r\n\r\n// re-run setup once slides arrive asynchronously after mount\r\nwatch(() => props.slides, async (newSlides, oldSlides) => {\r\n  if (newSlides?.length && !oldSlides?.length) {\r\n    revealImageSrc.value = newSlides[0].image\r\n    await nextTick()\r\n    updateTrackLayout()\r\n    playIntroAnimation()\r\n    startAutoPlay()\r\n  }\r\n})\r\n\r\nonMounted(() => {\r\n  updateTrackLayout()\r\n  playIntroAnimation()\r\n  startAutoPlay()\r\n})\r\n\r\nonBeforeUnmount(() => {\r\n  stopAutoPlay()\r\n  if (activeTimeline) activeTimeline.kill()\r\n  gsap.killTweensOf([\r\n    bgImageRef.value, bgRevealRef.value,\r\n    subTitleRef.value, titleRef.value, descRef.value, btnRef.value, mobileNumRef.value\r\n  ].filter(Boolean))\r\n  if (trackRowRef.value) gsap.killTweensOf(trackRowRef.value.children)\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.z-index-1 { z-index: 1; }\r\n.z-index-2 { z-index: 2; }\r\n.z-index-3 { z-index: 3; position: relative; }\r\n.gap-3 { gap: 12px; }\r\n.gap-4 { gap: 16px; }\r\n.object-cover { object-fit: cover; }\r\n.truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n\r\n.text-animation-container span,\r\n.text-animation-container h2,\r\n.text-animation-container p,\r\n.text-animation-container div,\r\n.mobile-number-box {\r\n  opacity: 0;\r\n}\r\n\r\n.main-bg-wrapper {\r\n  overflow: hidden;\r\n}\r\n\r\n.bg-reveal-layer {\r\n  opacity: 0;\r\n  clip-path: circle(0% at 50% 50%);\r\n  pointer-events: none;\r\n  will-change: clip-path, opacity;\r\n}\r\n\r\n.index-track-window {\r\n  width: 420px;\r\n  height: 200px;\r\n  overflow: visible;\r\n  position: relative;\r\n}\r\n\r\n.track-row {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.bg-gradient-vertical {\r\n  background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0) 100%);\r\n}\r\n\r\n.thumbnail-card {\r\n  width: 130px;\r\n  height: 180px;\r\n  top: 10px;\r\n  left: 0;\r\n  position: absolute;\r\n  will-change: transform, opacity;\r\n  transition: filter 0.4s ease;\r\n  filter: grayscale(35%);\r\n  cursor: pointer !important;\r\n  pointer-events: auto !important;\r\n}\r\n\r\n.thumbnail-card.is-active {\r\n  filter: grayscale(0%);\r\n}\r\n\r\n.mobile-number-box {\r\n  width: 100px;\r\n  height: 100px;\r\n  background: rgba(255, 255, 255, 0.05);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid;\r\n  letter-spacing: -2px;\r\n}\r\n\r\n.transition-width { transition: width 0.4s ease-out; }\r\n.transition-colors { transition: color 0.4s ease, border-color 0.4s ease; }\r\n.max-w-sm { max-width: 420px; }\r\n.max-w-xs { max-width: 240px; }\r\n.max-w-md { max-width: 460px; }\r\n.inset-0 { top: 0; left: 0; right: 0; bottom: 0; }\r\n.pt-mobile{\r\n  padding-top: 80px;\r\n}\r\n</style>\r\n"],"version":3}