low:unset;white-space: normal\"></v-card-title>\r\n          <v-card-subtitle class=\"text-white\" style=\"text-overflow:unset;white-space: normal\"\r\n                           v-html=\"description\"></v-card-subtitle>\r\n        </div>\r\n        <template v-if=\"btn_title!=='' && btn_title!==null\">\r\n          <v-btn v-if=\"(btn_link!=='#EVENT#' && typeof btn_link!=='undefined') || typeof to!=='undefined'\"\r\n                 :to=\"typeof btn_link!=='undefined' ? btn_link : to\" v-text=\"btn_title\" :color=\"btn_color\"\r\n                 :style=\"typeof btn_text_color!=='undefined' ? 'color:' + btn_text_color : ''\" rounded\r\n                 class=\"align-self-end mr-3 mt-4\"></v-btn>\r\n          <v-btn v-else @click=\"()=>$emit('doBtn')\" v-text=\"btn_title\" :color=\"btn_color\"\r\n                 :style=\"typeof btn_text_color!=='undefined' ? 'color:' + btn_text_color : ''\" rounded\r\n                 class=\"align-self-end mr-3 mt-4\"></v-btn>\r\n        </template>\r\n      </div>\r\n    </v-img>\r\n  </v-card>\r\n</template>\r\n\r\n<script setup>\r\nconst props = defineProps(['title', 'description', 'btn_title', 'btn_link', 'to', 'btn_color', 'background', 'gradient', 'height', 'btn_text_color', 'texts_position'])\r\n</script>\r\n\r\n<style>\r\n.v-img__gradient {\r\n  transition-property: opacity;\r\n  transition-duration: 1s;\r\n  transition-timing-function: ease-in-out;\r\n}\r\n\r\n.v-img__img {\r\n  transition-property: scale;\r\n  transition-duration: 1s;\r\n  transition-timing-function: ease-in-out;\r\n}\r\n\r\n.reverse_gradient:hover div.v-img__gradient {\r\n  opacity: 0.5;\r\n}\r\n\r\n.reverse_gradient:hover .v-img__img {\r\n  scale: 1.1;\r\n}\r\n.spaceBetween{\r\n  flex:1 ; height:100% ; justify-content:space-between\r\n}\r\n</style>\r\n"],"version":3}