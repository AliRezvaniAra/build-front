;AAAA,YACX,eAAeA,MAAA,YAAA,EAAa;AAAA,YAC5B,QAAQA,MAAA,MAAA;AAAA,UAAA;;;YAIR,OAAOA,MAAA,YAAA,EAAa;AAAA,YACpB,MAAMA,MAAA,MAAA;AAAA,YACN,MAAMA,MAAA,IAAA;AAAA,YACN,WAAWA,MAAA,SAAA;AAAA,YACX,eAAeA,MAAA,YAAA,EAAa;AAAA,YAC5B,QAAQA,MAAA,MAAA;AAAA,UAAA;;;;;;;QAIF,OAAA;AAAA,QAAM,OAAM;AAAA,MAAA;yBAAzB,CAEc,GAAAC,QAAAC,UAAA,aAAA;;;cADH,MAAMF,MAAA,QAAA,GAAU,QAAI,CAAA;AAAA,cAAS,cAAYA,MAAA,YAAA,EAAa;AAAA,cAAa,QAAQA,MAAA,MAAA;AAAA,YAAA;;;cAApFG,YAA6F,QAAA;AAAA,gBAApF,MAAMH,MAAA,QAAA,GAAU,QAAI,CAAA;AAAA,gBAAS,cAAYA,MAAA,YAAA,EAAa;AAAA,gBAAa,QAAQA,MAAA,MAAA;AAAA,cAAA;;;;;;;QAG7E,MAAMA,MAAA,UAAA,GAAY,QAAI,CAAA;AAAA,QAAQ,cAAW;AAAA,QAAM,WAAU;AAAA,QAAa,QAAQA,MAAA,MAAA;AAAA,MAAA;AACjE,YAAAI,mBAAA,mBAAA,EAAA,QAAQJ,MAAA,MAAA,EAAA,GAAM,MAAA,OAAA,CAAA;;;;;;;;;;;","names":["_withAsyncContext","_unref","_push","_parent","_createVNode","_ssrRenderComponent"],"sources":["../../../../app/pages/[lang]/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\r\nimport { useRoute } from \"vue-router\";\r\nimport Header1 from \"../../components/editorElements/elements/headers/header1.vue\";\r\nimport Header1Mobile from \"../../components/editorElements/elements/headers/header1Mobile.vue\";\r\nimport Render from \"../../components/editorElements/Render.vue\";\r\nimport FavAndbasketIcons from \"../../components/editorElements/elements/favAndbasketIcons.vue\";\r\nimport type {Row} from \"../../types/EditorTypes\";\r\n\r\n// 1. Setup context\r\nconst route = useRoute()\r\nconst config = useRuntimeConfig()\r\nconst { mdAndUp } = useDisplay()\r\nconst isLoading = ref(true)\r\n\r\n// Helper to get lang safely\r\nconst langParam = computed(() => route.params.lang?.toString() || 'en')\r\n\r\n/** * 2. Parallel Fetching (SSR Optimized)\r\n * This block replaces all individual useAsyncData + watch calls.\r\n */\r\nconst [\r\n  { data: languages },\r\n  { data: settingsData },\r\n  { data: rowsData },\r\n  { data: footerData },\r\n  { data: header },\r\n  { data: menu }\r\n] = await Promise.all([\r\n  useAsyncData('languages', () => $fetch(`/api/languages`, { baseURL: config.public.baseUrl })),\r\n\r\n  useAsyncData(`settings-${langParam.value}`, () =>\r\n      $fetch<any>(`/api/pages/get/title/${langParam.value}`, { baseURL: config.public.baseUrl })),\r\n\r\n  useAsyncData(`rows-${langParam.value}`, () =>\r\n      $fetch<any>(`/api/pages/rows/title/${langParam.value}`, { baseURL: config.public.baseUrl })),\r\n\r\n  useAsyncData(`footer-${langParam.value}`, () =>\r\n      $fetch<any>(`/api/pages/rows/0-footer-${langParam.value}`, { baseURL: config.public.baseUrl })),\r\n\r\n  useAsyncData<Row[]>(`header-data-${langParam.value}`, () =>\r\n      $fetch(`/api/pages/rows/0-header-${langParam.value}`, {baseURL: config.public.baseUrl}).then((r: any) => r.data || [])),\r\n\r\n  useAsyncData('menu-data', () =>\r\n      $fetch<any>(`/api/menus/get`, { baseURL: config.public.baseUrl }).then(r => r.data || []))\r\n])\r\n\r\n/**\r\n * 3. Reactive State derived from API data\r\n */\r\nconst locale = computed(() => settingsData.value?.data?.lang || langParam.value)\r\nconst isRtl = computed(() => locale.value === 'fa' || locale.value === 'ar')\r\n\r\nconst pageSettings = computed(() => ({\r\n  title: settingsData.value?.data?.title ?? \"\",\r\n  theme: settingsData.value?.data?.nav_theme ?? \"light\",\r\n  margin_top: settingsData.value?.data?.margin_top ?? null,\r\n  seo_title: settingsData.value?.data?.seo_title ?? \"\",\r\n  seo_description: settingsData.value?.data?.seo_description ?? \"\",\r\n  related_pages: settingsData.value?.data?.related_pages ?? []\r\n}))\r\n\r\n/**\r\n * 4. SEO & Head (Declarative)\r\n * No need for document.getElementById or manual DOM manipulation.\r\n */\r\nuseHead({\r\n  htmlAttrs: {\r\n    lang: () => locale.value,\r\n    dir: () => isRtl.value ? 'rtl' : 'ltr'\r\n  },\r\n  link: () => isRtl.value\r\n      ? [{ id: 'rtl-stylesheet', rel: 'stylesheet', href: '/css/rtl.css' }]\r\n      : []\r\n})\r\n\r\nuseSeoMeta({\r\n  title: () => pageSettings.value.seo_title || pageSettings.value.title,\r\n  description: () => pageSettings.value.seo_description,\r\n})\r\n\r\n// Loading control\r\nonMounted(() => {\r\n  setTimeout(() => { isLoading.value = false }, 400)\r\n})\r\n</script>\r\n\r\n<template>\r\n  <div v-if=\"isLoading\" :class=\"['page-loading', !isLoading ? 'hideLoadingEffect' : '']\">\r\n    <div class=\"spinner\"></div>\r\n  </div>\r\n\r\n  <template v-if=\"languages\">\r\n    <Header1\r\n        v-if=\"mdAndUp\"\r\n        :theme=\"pageSettings.theme\"\r\n        :header=\"header\"\r\n        :menu=\"menu\"\r\n        :languages=\"languages\"\r\n        :related_pages=\"pageSettings.related_pages\"\r\n        :locale=\"locale\"\r\n    />\r\n    <Header1Mobile\r\n        v-else\r\n        :theme=\"pageSettings.theme\"\r\n        :rows=\"header\"\r\n        :menu=\"menu\"\r\n        :languages=\"languages\"\r\n        :related_pages=\"pageSettings.related_pages\"\r\n        :locale=\"locale\"\r\n    />\r\n  </template>\r\n\r\n  <v-container fluid class=\"pa-0 d-flex flex-column\">\r\n    <Render :rows=\"rowsData?.data ?? []\" :margin-top=\"pageSettings.margin_top\" :locale=\"locale\"/>\r\n  </v-container>\r\n\r\n  <Render :rows=\"footerData?.data ?? []\" margin-top=\"0px\" is_footer=\"is_footer\" :locale=\"locale\"/>\r\n  <fav-andbasket-icons :locale=\"locale\" />\r\n</template>\r\n\r\n<style scoped lang=\"sass\">\r\n</style>"],"version":3}